# Data only: KEY=value, optional surrounding quotes. No shell expansion.
# Install root:postgres 0640; archive_command must be able to read this file.
MERCATO_ENVIRONMENT=prod
PGBACKREST_CONFIG=/etc/pgbackrest/pgbackrest.conf
PGBACKREST_STANZA=mercato
PGBACKREST_REPO1_S3_KEY=REPLACE_OCI_CUSTOMER_ACCESS_KEY
PGBACKREST_REPO1_S3_KEY_SECRET=REPLACE_OCI_CUSTOMER_SECRET_KEY
PGBACKREST_REPO1_CIPHER_PASS=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_FROM_OFF_INSTANCE_VAULT
OCI_NAMESPACE=REPLACE_NAMESPACE
OCI_BUCKET=REPLACE_PRIVATE_BACKUP_BUCKET
OCI_REGION=ap-mumbai-1
OCI_AUTH=instance_principal
PGDATA=/var/lib/postgresql/14/main
PGDATABASE=mercato
PGHOST=/var/run/postgresql
PGPORT=5432
PGBIN=/usr/lib/postgresql/14/bin
CAPACITY_EVIDENCE=/etc/mercato/backup-capacity.json
KEY_RECOVERY_EVIDENCE=/etc/mercato/backup-key-recovery.json
BACKUP_HEARTBEAT_URL=https://hc-ping.com/REPLACE_PRIVATE_DAILY_BACKUP_UUID
WAL_HEARTBEAT_URL=https://hc-ping.com/REPLACE_PRIVATE_WAL_MONITOR_UUID
DRILL_ROOT=/var/lib/mercato-restore-drill
STATE_DIRECTORY=/var/lib/mercato-backup
