[global]
repo1-type=s3
repo1-path=/mercato/prod
repo1-s3-endpoint=REPLACE_NAMESPACE.compat.objectstorage.ap-mumbai-1.oraclecloud.com
repo1-s3-region=ap-mumbai-1
repo1-s3-bucket=REPLACE_PRIVATE_BACKUP_BUCKET
repo1-s3-uri-style=path
repo1-storage-verify-tls=y
repo1-cipher-type=aes-256-cbc
repo1-retention-full=4
repo1-retention-full-type=count
repo1-retention-archive=4
repo1-retention-archive-type=full
archive-async=n
archive-check=y
archive-timeout=180
start-fast=y
process-max=2
compress-type=zst
log-level-console=warn
log-level-file=info
log-path=/var/log/pgbackrest
lock-path=/var/lib/pgbackrest/lock
spool-path=/var/spool/pgbackrest

[mercato]
pg1-path=/var/lib/postgresql/14/main
pg1-port=5432
pg1-socket-path=/var/run/postgresql
