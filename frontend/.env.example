# API requests use the same-origin /api proxy (Vite locally, Netlify in staging/production).
VITE_CASHFREE_MODE=sandbox
VITE_FREE_SHIPPING_ABOVE=999

# Backend CASHFREE_RETURN_URL must match the canonical post-payment route:
# http://localhost:5173/checkout/payment-confirmation
# (/payment-confirmation also works as an alias)
